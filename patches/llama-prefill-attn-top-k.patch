+                                                   n_live, n_head_kv, ns, 1);
+                ggml_set_input(inp->pool_idx);
+                ggml_set_name(inp->pool_idx, "edge_pool_idx");
+                inp->pool_idx_m = ggml_new_tensor_4d(ctx0, GGML_TYPE_I32,
+                                                     n_live, 1, ns, 1);
+                ggml_set_input(inp->pool_idx_m);
+                ggml_set_name(inp->pool_idx_m, "edge_pool_idx_m");
+            }
+
+            // Pooled K. pool_1d pools along dim0 of a standard contiguous
+            // tensor, so materialize the rows-major view
+            // [n_kv, n_embd_h, n_head_kv, ns]. Note ggml_permute uses
+            // destination semantics (ne[axis_i] = a->ne[i]), so moving the
+            // kv axis (a->ne[2]) to dim0 is permute(1, 2, 0, 3). The
+            // kernel reads F16 natively and outputs F32.
+            ggml_tensor * k_rows = ggml_cont(ctx0,
+                    ggml_permute(ctx0, k_full, 1, 2, 0, 3));
+            ggml_tensor * k_pool = ggml_pool_1d(ctx0, k_rows,
+                    GGML_OP_POOL_AVG, 32, 32, 0);
+            // [n_pool_full, n_embd_h, n_head_kv, ns] -> row-gatherable
+            // [n_embd_h, n_pool_full, n_head_kv, ns]; get_rows requires a
+            // dim0-contiguous src0, hence the materialized permute.
+            ggml_tensor * k_pool_c = ggml_cont(ctx0,
+                    ggml_permute(ctx0, k_pool, 1, 0, 2, 3));
+            ggml_tensor * k_sel = ggml_get_rows(ctx0, k_pool_c, inp->pool_idx);
+            // Back to the standard cache layout [n_embd_h, n_head_kv,
+            // n_live, ns] so the concat below extends the kv axis (dim2).
+            k_sel = ggml_cont(ctx0, ggml_permute(ctx0, k_sel, 0, 2, 1, 3));
+            if (k_sel->type != type_k_src &&
+                (type_k_src == GGML_TYPE_F16 || type_k_src == GGML_TYPE_BF16)) {
+                k_sel = ggml_cast(ctx0, k_sel, type_k_src);
+            }
+
+            // Pooled V: normalize the two cache layouts first, then mirror
+            // the K path.
+            const bool v_trans = v_full->nb[1] > v_full->nb[2];
+            ggml_tensor * v_norm = v_trans
+                ? ggml_cont(ctx0, ggml_permute(ctx0, v_full, 2, 1, 0, 3))
+                : v_full;
+            ggml_tensor * v_rows = ggml_cont(ctx0,
+                    ggml_permute(ctx0, v_norm, 1, 2, 0, 3));
+            ggml_tensor * v_pool = ggml_pool_1d(ctx0, v_rows,
+                    GGML_OP_POOL_AVG, 32, 32, 0);
+            ggml_tensor * v_pool_c = ggml_cont(ctx0,
+                    ggml_permute(ctx0, v_pool, 1, 0, 2, 3));
+            ggml_tensor * v_sel = ggml_get_rows(ctx0, v_pool_c, inp->pool_idx);
+            v_sel = ggml_cont(ctx0, ggml_permute(ctx0, v_sel, 0, 2, 1, 3));
+            if (v_sel->type != type_v_src &&
+                (type_v_src == GGML_TYPE_F16 || type_v_src == GGML_TYPE_BF16)) {
+                v_sel = ggml_cast(ctx0, v_sel, type_v_src);
+            }
+
+            // k/v are in the standard cache layout in both the gathered
+            // and dense cases; append the pooled rows on the kv axis.
+            k = ggml_concat(ctx0, k, k_sel, 2);
+            v = ggml_concat(ctx0, v, v_sel, 2);
+
+            // Pooled-row causal mask: gather the pre-gather mask rows of
+            // each block's last token (its position is the block max_pos,
+            // so the row encodes exactly q_pos > block_max_pos).
+            ggml_tensor * m_p = ggml_cont(ctx0,
+                    ggml_permute(ctx0, mask_full, 1, 0, 2, 3));
+            ggml_tensor * m_pool = ggml_get_rows(ctx0, m_p, inp->pool_idx_m);
+            m_pool = ggml_cont(ctx0, ggml_permute(ctx0, m_pool, 1, 0, 2, 3));
+            if (m_pool->type != mask_full->type) {
+                m_pool = ggml_cast(ctx0, m_pool, mask_full->type);
+            }
+            ggml_tensor * mask_cur = scalar_gathered ? kq_mask : mask_full;
+            kq_mask = ggml_concat(ctx0, mask_cur, m_pool, 0);
+        }
+    }
+
+    cur = build_attn_mha(q, k, v, kq_b, kq_mask, sinks, v_mla, 0, kq_scale, il);
+    }
     cb(cur, "kqv_out", il);
 
