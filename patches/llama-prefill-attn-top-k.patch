+    // (NULL, wrong length, element 0 or < -1, or a non-empty matrix without
+    // a ranked pool).
+    LLAMA_API int32_t llama_set_prefill_attn_head_top_k(
+            struct llama_context * ctx,
+            const int32_t        * top_k,
+                     size_t        n);
+
+    // Returns the current matrix length (n_layer * n_head), or 0 when unset.
