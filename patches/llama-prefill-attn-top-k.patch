+        // [n_embd_hv, n_head_kv, n_kv, ns] -> [n_embd_hv, n_kv, n_head_kv, ns]
+        ggml_tensor * v_p = ggml_permute(ctx0, v, 0, 2, 1, 3);
+        v = ggml_get_rows(ctx0, v_p, idx);
+        v = ggml_cont(ctx0, ggml_permute(ctx0, v, 0, 2, 1, 3));
+
+        // Gather the causal KQ mask rows so causality is preserved exactly:
+        // mask [n_kv, n_batch/n_stream, 1, n_stream] -> permute -> [n_batch/n_stream, n_kv, 1, n_stream]
+        // get_rows needs dim0-contiguous src0, so materialize the permuted mask.
+        ggml_tensor * m_p = ggml_cont(ctx0, ggml_permute(ctx0, kq_mask, 1, 0, 2, 3));
+        // head-0 slice of idx: [n_idx, 1, n_stream, 1]
+        ggml_tensor * idx_m = ggml_view_4d(ctx0, idx,
+                idx->ne[0], 1, idx->ne[2], 1,
+                idx->nb[0], idx->nb[1], idx->nb[2], 0);
+        kq_mask = ggml_get_rows(ctx0, m_p, idx_m);
+        // [n_batch/n_stream, n_idx, 1, n_stream] -> [n_idx, n_batch/n_stream, 1, n_stream]
+        // ggml_soft_max requires a contiguous mask.
+        kq_mask = ggml_cont(ctx0, ggml_permute(ctx0, kq_mask, 1, 0, 2, 3));
