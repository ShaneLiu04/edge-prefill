+        // attention matmuls use the same vec_dot path (and hence the same
+        // rounding) as the original dense path.
+        if (k->type != type_k_src &&
+            (type_k_src == GGML_TYPE_F16 || type_k_src == GGML_TYPE_BF16)) {
+            k = ggml_cast(ctx0, k, type_k_src);
+        }
+        if (v->type != type_v_src &&
+            (type_v_src == GGML_TYPE_F16 || type_v_src == GGML_TYPE_BF16)) {
+            v = ggml_cast(ctx0, v, type_v_src);
+        }
