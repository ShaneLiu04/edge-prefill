+                ggml_tensor * cur3 = ggml_reshape_4d(ctx0, acc, acc->ne[0] / n_head,
+                                                     n_head, tn, 1);
+                layer.out_perm_idx = ggml_new_tensor_4d(ctx0, GGML_TYPE_I32,
+                                                        n_head, tn, 1, 1);
+                ggml_set_input(layer.out_perm_idx);
+                ggml_set_name(layer.out_perm_idx, "edge_out_perm_idx");
+                ggml_tensor * restored = ggml_get_rows(ctx0, cur3, layer.out_perm_idx);
+                cur = ggml_reshape_2d(ctx0, restored,
+                                      restored->ne[0] * restored->ne[1], tn);
+            }
+        }
+    }
+
+    // EdgePrefill AR004: MoBA-style query-chunk gating. Replaces the
+    // scalar gather while active: the decode's queries are partitioned
+    // into contiguous groups (cparams bounds) and every group attends
+    // only its own live row set; the group outputs concatenate back into
+    // the original token order. Any geometry mismatch (bounds not
+    // covering the ubatch, multi-stream ubatch, scalar still armed)
+    // leaves cur unset so the original dense path runs.
+    if (!cur &&
+        cparams.prefill_mode &&
+        cparams.prefill_qg_count > 0 &&
+        cparams.prefill_attn_top_k == 0 &&
+        cparams.prefill_attn_head_top_k.empty() &&
+        cparams.prefill_attn_pool_starts.empty() &&
+        !cparams.flash_attn && kq_b == nullptr && sinks == nullptr &&
+        v_mla == nullptr && k->ne[3] == 1) {
+        const int32_t  G     = cparams.prefill_qg_count;
+        const auto   & qb    = cparams.prefill_qg_bounds;
+        const auto   & qrows = cparams.prefill_qg_rows;
+        const auto   & qoff  = cparams.prefill_qg_offsets;
+        const int64_t  n_tok = q->ne[2];
+        const int64_t  n_kv  = k->ne[2];
+
+        // The plan must tile this ubatch's query axis exactly and every
+        // group must carry a configured row slice.
+        bool plan_ok = qb.size() == static_cast<size_t>(G) + 1 &&
+                       qoff.size() == static_cast<size_t>(G) + 1 &&
+                       qb[0] == 0 && qb.back() == n_tok && n_kv >= 1;
+        for (int32_t g = 0; plan_ok && g < G; ++g) {
+            plan_ok = qb[g] < qb[g + 1] &&
+                      qoff[g] >= 0 && qoff[g] <= qoff[g + 1] &&
+                      qoff[g + 1] <= static_cast<int32_t>(qrows.size());
+        }
+        if (plan_ok) {
+            const int64_t n_head_kv = k->ne[1];
+
+            // Bake the live-filtered per-group sets per graph; the idx
+            // input tensors are shared by every layer (a per-layer
+            // creation would leave all but the last layer unfilled).
+            // Re-bake whenever the cache width or the content epoch moved:
+            // chunked prefill widens n_kv per ubatch, so a set baked for an
+            // earlier chunk would silently truncate the later chunks'
+            // visible rows to the earlier width.
+            if (inp->qg_idx.empty() ||
+                    inp->qg_n_kv != n_kv ||
+                    inp->edge_epoch != cparams.prefill_edge_epoch) {
+                inp->qg_bounds.assign(qb.begin(), qb.end());
+                inp->qg_n_kv = n_kv;
+                inp->edge_epoch = cparams.prefill_edge_epoch;
+                inp->qg_rows.resize(G);
+                inp->qg_idx.resize(G, nullptr);
+                inp->qg_idx_m.resize(G, nullptr);
+                for (int32_t g = 0; g < G; ++g) {
+                    std::vector<int32_t> live;
+                    for (int32_t i = qoff[g]; i < qoff[g + 1]; ++i) {
+                        if (qrows[i] >= 0 && qrows[i] < n_kv) {
+                            live.push_back(qrows[i]);
+                        }
+                    }
