+    const std::vector<int32_t> & get_prefill_qg_rows() const { return cparams.prefill_qg_rows; }
+    const std::vector<int32_t> & get_prefill_qg_offsets() const { return cparams.prefill_qg_offsets; }
+    // Append-only: the C API only allows setting group g after groups
