+                    // for every query (an all-masked softmax row is NaN).
+                    if (live.empty()) {
+                        live.push_back(0);
+                    }
+                    inp->qg_rows[g] = std::move(live);
+                    inp->qg_idx[g] = ggml_new_tensor_4d(ctx0, GGML_TYPE_I32,
+                            static_cast<int64_t>(inp->qg_rows[g].size()),
+                            n_head_kv, 1, 1);
+                    ggml_set_input(inp->qg_idx[g]);
+                    ggml_set_name(inp->qg_idx[g], "edge_qg_idx");
+                    inp->qg_idx_m[g] = ggml_new_tensor_4d(ctx0, GGML_TYPE_I32,
+                            static_cast<int64_t>(inp->qg_rows[g].size()),
+                            1, 1, 1);
+                    ggml_set_input(inp->qg_idx_m[g]);
+                    ggml_set_name(inp->qg_idx_m[g], "edge_qg_idx_m");
+                }
+            }
