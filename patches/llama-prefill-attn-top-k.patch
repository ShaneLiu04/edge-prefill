+    // EdgePrefill AR004: attention-level compressed branches. The live
+    // block list is computed once per graph build from cparams (blocks
+    // beyond the chunk's live KV width are dropped) and shared by every
+    // layer. pool_ids/pool_last are baked at build time so set_input only
+    // copies them; pool_n_kv snapshots the live width for can_reuse.
+    ggml_tensor * pool_idx = nullptr;    // I32 [n_live, n_head_kv, n_stream, 1] pooled-row ids (start/32)
+    ggml_tensor * pool_idx_m = nullptr;  // I32 [n_live, 1, n_stream, 1] causal-mask row ids (start+31)
+    std::vector<int32_t> pool_ids;       // baked pooled-row id per live block
+    std::vector<int32_t> pool_last;      // baked last cache row per live block
+    int64_t pool_n_kv = -1;              // reuse snapshot; -1 = feature was off
+
+    // EdgePrefill AR004: MoBA-style query-chunk gating. The graph loops
+    // over query groups; each group gathers its own live KV rows
+    // (qg_rows, filtered to the build-time cache width) and attends only
+    // its query slice (qg_bounds). idx tensors are created once per
+    // graph (shared by every layer); qg_n_kv plus the cparams epoch let
+    // can_reuse reject stale graphs.
+    std::vector<ggml_tensor *> qg_idx;    // I32 [n_rows_g, n_head_kv, n_stream, 1] per group
+    std::vector<ggml_tensor *> qg_idx_m;  // I32 [n_rows_g, 1, n_stream, 1] per group (mask rows)
+    std::vector<std::vector<int32_t>> qg_rows;  // baked live rows per group
+    std::vector<int32_t> qg_bounds;            // baked query bounds (group count + 1)
+    int64_t qg_n_kv = -1;                 // reuse snapshot; -1 = feature was off
+    uint64_t edge_epoch = 0;               // cparams epoch at build (pool/qg staleness)
+
+    // EdgePrefill AR006: in-graph query-aware bound gating. The bias and
+    // local-row index tensors are deterministic from the build-time cache
+    // width and the cparams budgets, so set_input refills them on reuse.
+    //   bound_bias      F32 [n_pages]  0 for selectable pages, -INF for
+    //                                  local pages (sink page and the
+    //                                  trailing window) so a page is never
+    //                                  both selected and local.
+    //   bound_local_idx I32 [n_local]  local rows (sink page rows plus the
+    //                                  trailing window), ascending, unique.
+    //   bound_row_table I32 [32, n_pages]  page-id -> row-id lookup:
+    //                                  element (r, p) = p*32 + r. The graph
+    //                                  gathers it with the selected page ids
+    //                                  to expand a page selection into rows
+    //                                  without integer arithmetic on
+    //                                  tensors (ggml has no I32 cast path).
+    ggml_tensor * bound_bias      = nullptr;
+    ggml_tensor * bound_local_idx = nullptr;
+    ggml_tensor * bound_row_table = nullptr;
+    // kq_mask pre-transposed to row-major [n_tok, n_kv] once per graph
+    // (layer-independent), so page gating does not pay a per-layer mask
+    // copy: gathering its rows yields the causal mask of the gathered keys.
+    ggml_tensor * bound_mask_p    = nullptr;
+    int64_t bound_n_kv = -1;              // reuse snapshot; -1 = feature was off
+
