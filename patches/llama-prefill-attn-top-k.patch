+            const ggml_type type_k_src = k->type;
+            const ggml_type type_v_src = v->type;
+            const bool v_trans = v->nb[1] > v->nb[2];
+            ggml_tensor * v_norm = v_trans
+                ? ggml_cont(ctx0, ggml_permute(ctx0, v, 2, 1, 0, 3))
+                : v;
+            // Row-gatherable views along dim1 for get_rows.
+            ggml_tensor * k_p = ggml_permute(ctx0, k, 0, 2, 1, 3);
+            ggml_tensor * v_p = ggml_permute(ctx0, v_norm, 0, 2, 1, 3);
+            ggml_tensor * m_p = ggml_cont(ctx0,
+                    ggml_permute(ctx0, kq_mask, 1, 0, 2, 3));
+
+            ggml_tensor * acc = nullptr;
+            for (int32_t g = 0; g < G; ++g) {
+                const int64_t lo = qb[g];
+                const int64_t hi = qb[g + 1];
+
+                // Query slice along the token axis.
+                ggml_tensor * q_g = ggml_view_4d(ctx0, q,
+                        q->ne[0], q->ne[1], hi - lo, q->ne[3],
+                        q->nb[1], q->nb[2], q->nb[3], lo * q->nb[2]);
+
+                // K/V row gather (scalar-path pattern, per-group idx).
+                ggml_tensor * k_g = ggml_get_rows(ctx0, k_p, inp->qg_idx[g]);
+                k_g = ggml_cont(ctx0, ggml_permute(ctx0, k_g, 0, 2, 1, 3));
+                if (k_g->type != type_k_src &&
+                    (type_k_src == GGML_TYPE_F16 || type_k_src == GGML_TYPE_BF16)) {
+                    k_g = ggml_cast(ctx0, k_g, type_k_src);
+                }
+                ggml_tensor * v_g = ggml_get_rows(ctx0, v_p, inp->qg_idx[g]);
+                v_g = ggml_cont(ctx0, ggml_permute(ctx0, v_g, 0, 2, 1, 3));
+                if (v_g->type != type_v_src &&
+                    (type_v_src == GGML_TYPE_F16 || type_v_src == GGML_TYPE_BF16)) {
+                    v_g = ggml_cast(ctx0, v_g, type_v_src);
+                }
+
+                // Causal mask: gather the group's rows, then keep only
+                // the group's query columns.
+                ggml_tensor * m_g = ggml_get_rows(ctx0, m_p, inp->qg_idx_m[g]);
+                m_g = ggml_view_4d(ctx0, m_g,
+                        hi - lo, m_g->ne[1], m_g->ne[2], m_g->ne[3],
+                        m_g->nb[1], m_g->nb[2], m_g->nb[3], lo * m_g->nb[0]);
+                m_g = ggml_cont(ctx0, ggml_permute(ctx0, m_g, 1, 0, 2, 3));
+                if (m_g->type != kq_mask->type) {
+                    m_g = ggml_cast(ctx0, m_g, kq_mask->type);
+                }
+
+                ggml_tensor * out_g = build_attn_mha(
+                        q_g, k_g, v_g, nullptr, m_g, nullptr, nullptr,
+                        0, kq_scale, il);
+                // Groups tile the query axis ascending, so the plain
+                // token-axis concat restores the original order.
+                acc = acc ? ggml_concat(ctx0, acc, out_g, 1) : out_g;
+            }
+            cur = acc;
+        }
+    }
+
+    if (!cur) {
+    // EdgePrefill AR004: remember the pre-gather K/V/mask so the pooled
+    // compressed branch can read the full cache rows even after the scalar
+    // gather below has replaced k/v/kq_mask.
+    ggml_tensor * k_full = k;
+    ggml_tensor * v_full = v;
+    ggml_tensor * mask_full = kq_mask;
+    bool scalar_gathered = false;
+    // EdgePrefill: attention-level top-k gather during prefill. Gathers K, V
+    // and the causal KQ mask rows selected by the caller's indices, reducing
+    // the attention width from n_kv to n_idx. Falls back to the original
+    // dense path whenever any precondition is unmet (disabled, no indices,
+    // non-uniform GQA, flash attention, or no reduction possible).
+    if (inp->self_attn_idx && cparams.prefill_mode &&
+        cparams.prefill_attn_top_k > 0 &&
+        static_cast<int64_t>(cparams.prefill_attn_top_k) < k->ne[2] &&
+        hparams.n_head_kv(il) == inp->self_attn_idx->ne[1] &&
+        !cparams.flash_attn) {
+        ggml_tensor * idx = inp->get_attn_idx();
+        // [n_idx, n_head_kv, n_stream, 1], filled by set_input
+        const ggml_type type_k_src = k->type;
+        const ggml_type type_v_src = v->type;
+
+        // Gather K rows along the KV dimension:
+        // [n_embd_h, n_head_kv, n_kv, ns] -> permute -> [n_embd_h, n_kv, n_head_kv, ns]
+        ggml_tensor * k_p = ggml_permute(ctx0, k, 0, 2, 1, 3);
+        k = ggml_get_rows(ctx0, k_p, idx);
+        // [n_embd_h, n_idx, n_head_kv, ns] -> permute back; cont so that
+        // build_attn_mha's own permute yields a non-transposed mul_mat input.
+        k = ggml_cont(ctx0, ggml_permute(ctx0, k, 0, 2, 1, 3));
+
+        // Gather V rows; the V cache has two possible layouts. get_rows needs
+        // dim0-contiguous src0, so the transposed layout is first normalized
+        // to the non-trans layout with a materialized permute. In both cases
+        // the gather-back produces the non-trans layout
+        // [n_embd_hv, n_head_kv, n_idx, ns] so that build_attn_mha's
+        // v_trans detection and !v_trans handling work correctly.
+        const bool v_trans = v->nb[1] > v->nb[2];
+        if (v_trans) {
+            // [n_kv, n_head_kv, n_embd_hv, ns] -> [n_embd_hv, n_head_kv, n_kv, ns]
+            v = ggml_cont(ctx0, ggml_permute(ctx0, v, 2, 1, 0, 3));
+        }
+        // [n_embd_hv, n_head_kv, n_kv, ns] -> [n_embd_hv, n_kv, n_head_kv, ns]
+        ggml_tensor * v_p = ggml_permute(ctx0, v, 0, 2, 1, 3);
+        v = ggml_get_rows(ctx0, v_p, idx);
+        v = ggml_cont(ctx0, ggml_permute(ctx0, v, 0, 2, 1, 3));
+
+        // Gather the causal KQ mask rows so causality is preserved exactly:
+        // mask [n_kv, n_batch/n_stream, 1, n_stream] -> permute -> [n_batch/n_stream, n_kv, 1, n_stream]
+        // get_rows needs dim0-contiguous src0, so materialize the permuted mask.
+        ggml_tensor * m_p = ggml_cont(ctx0, ggml_permute(ctx0, kq_mask, 1, 0, 2, 3));
+        // head-0 slice of idx: [n_idx, 1, n_stream, 1]
+        ggml_tensor * idx_m = ggml_view_4d(ctx0, idx,
+                idx->ne[0], 1, idx->ne[2], 1,
+                idx->nb[0], idx->nb[1], idx->nb[2], 0);
+        kq_mask = ggml_get_rows(ctx0, m_p, idx_m);
+        // [n_batch/n_stream, n_idx, 1, n_stream] -> [n_idx, n_batch/n_stream, 1, n_stream]
+        // ggml_soft_max requires a contiguous mask.
+        kq_mask = ggml_cont(ctx0, ggml_permute(ctx0, kq_mask, 1, 0, 2, 3));
+
+        // get_rows materializes F16/BF16 sources as F32; cast back so the
+        // attention matmuls use the same vec_dot path (and hence the same
+        // rounding) as the original dense path.
+        if (k->type != type_k_src &&
+            (type_k_src == GGML_TYPE_F16 || type_k_src == GGML_TYPE_BF16)) {
+            k = ggml_cast(ctx0, k, type_k_src);
+        }
+        if (v->type != type_v_src &&
+            (type_v_src == GGML_TYPE_F16 || type_v_src == GGML_TYPE_BF16)) {
+            v = ggml_cast(ctx0, v, type_v_src);
+        }
+        scalar_gathered = true;
+    }
+
+    // EdgePrefill AR004: attention-level compressed branches. Selected
+    // 32-row blocks that are not gathered are pooled (mean) into one
+    // appended KV row, so dropped context stays addressable at reduced
+    // fidelity. The pooled row is causally gated by the block's max
+    // position, which equals the pre-gather mask row of the block's last
+    // token. v1: exclusive with the per-head matrix path.
+    if (cparams.prefill_mode &&
+        !cparams.prefill_attn_pool_starts.empty() &&
+        cparams.prefill_attn_head_top_k.empty() &&
+        !cparams.flash_attn && kq_b == nullptr && sinks == nullptr &&
+        v_mla == nullptr) {
+        const int64_t n_kv = k_full->ne[2];
+        // Live blocks for this chunk: a pooled row exists only for blocks
+        // fully inside the live KV width; later chunks expose more blocks.
+        std::vector<int32_t> live_ids;
+        std::vector<int32_t> live_last;
+        for (size_t i = 0; i < cparams.prefill_attn_pool_starts.size(); ++i) {
+            const int32_t start = cparams.prefill_attn_pool_starts[i];
+            const int32_t size  = cparams.prefill_attn_pool_sizes[i];
+            if (static_cast<int64_t>(start) + size <= n_kv) {
+                live_ids.push_back(start / 32);
+                live_last.push_back(start + size - 1);
+            }
+        }
+        if (!live_ids.empty()) {
+            const int64_t n_head_kv = k_full->ne[1];
+            const int64_t ns        = k_full->ne[3];
+            const int64_t n_live    = static_cast<int64_t>(live_ids.size());
+            const ggml_type type_k_src = k_full->type;
+            const ggml_type type_v_src = v_full->type;
+
+            // Register the baked block list once per graph; set_input
+            // replicates the ids across GQA heads and streams. The tensors
+            // are members of the shared input object, so they must be
+            // created on the first layer only — a per-layer creation would
+            // leave every earlier layer's node unfilled (garbage row ids).
+            if (!inp->pool_idx) {
+                inp->pool_ids  = std::move(live_ids);
+                inp->pool_last = std::move(live_last);
+                inp->pool_n_kv = n_kv;
+                inp->edge_epoch = cparams.prefill_edge_epoch;
+                inp->pool_idx = ggml_new_tensor_4d(ctx0, GGML_TYPE_I32,
+                                                   n_live, n_head_kv, ns, 1);
+                ggml_set_input(inp->pool_idx);
+                ggml_set_name(inp->pool_idx, "edge_pool_idx");
+                inp->pool_idx_m = ggml_new_tensor_4d(ctx0, GGML_TYPE_I32,
+                                                     n_live, 1, ns, 1);
+                ggml_set_input(inp->pool_idx_m);
+                ggml_set_name(inp->pool_idx_m, "edge_pool_idx_m");
+            }
+
+            // Pooled K. pool_1d pools along dim0 of a standard contiguous
+            // tensor, so materialize the rows-major view
+            // [n_kv, n_embd_h, n_head_kv, ns]. Note ggml_permute uses
+            // destination semantics (ne[axis_i] = a->ne[i]), so moving the
+            // kv axis (a->ne[2]) to dim0 is permute(1, 2, 0, 3). The CPU
+            // pool_1d reads F16 natively, but the CUDA kernel asserts
+            // F32-only (pool1d.cu), so normalize the type up front; the
+            // pooled result is cast back to the cache type below.
+            ggml_tensor * k_rows = ggml_cont(ctx0,
+                    ggml_permute(ctx0, k_full, 1, 2, 0, 3));
+            if (k_rows->type != GGML_TYPE_F32) {
+                k_rows = ggml_cast(ctx0, k_rows, GGML_TYPE_F32);
+            }
+            ggml_tensor * k_pool = ggml_pool_1d(ctx0, k_rows,
+                    GGML_OP_POOL_AVG, 32, 32, 0);
+            // [n_pool_full, n_embd_h, n_head_kv, ns] -> row-gatherable
+            // [n_embd_h, n_pool_full, n_head_kv, ns]; get_rows requires a
+            // dim0-contiguous src0, hence the materialized permute.
+            ggml_tensor * k_pool_c = ggml_cont(ctx0,
+                    ggml_permute(ctx0, k_pool, 1, 0, 2, 3));
+            ggml_tensor * k_sel = ggml_get_rows(ctx0, k_pool_c, inp->pool_idx);
+            // Back to the standard cache layout [n_embd_h, n_head_kv,
+            // n_live, ns] so the concat below extends the kv axis (dim2).
+            k_sel = ggml_cont(ctx0, ggml_permute(ctx0, k_sel, 0, 2, 1, 3));
+            if (k_sel->type != type_k_src &&
+                (type_k_src == GGML_TYPE_F16 || type_k_src == GGML_TYPE_BF16)) {
+                k_sel = ggml_cast(ctx0, k_sel, type_k_src);
+            }
+
+            // Pooled V: normalize the two cache layouts first, then mirror
+            // the K path.
+            const bool v_trans = v_full->nb[1] > v_full->nb[2];
+            ggml_tensor * v_norm = v_trans
+                ? ggml_cont(ctx0, ggml_permute(ctx0, v_full, 2, 1, 0, 3))
+                : v_full;
+            ggml_tensor * v_rows = ggml_cont(ctx0,
+                    ggml_permute(ctx0, v_norm, 1, 2, 0, 3));
+            if (v_rows->type != GGML_TYPE_F32) {
+                v_rows = ggml_cast(ctx0, v_rows, GGML_TYPE_F32);
+            }
+            ggml_tensor * v_pool = ggml_pool_1d(ctx0, v_rows,
+                    GGML_OP_POOL_AVG, 32, 32, 0);
+            ggml_tensor * v_pool_c = ggml_cont(ctx0,
+                    ggml_permute(ctx0, v_pool, 1, 0, 2, 3));
+            ggml_tensor * v_sel = ggml_get_rows(ctx0, v_pool_c, inp->pool_idx);
+            v_sel = ggml_cont(ctx0, ggml_permute(ctx0, v_sel, 0, 2, 1, 3));
+            if (v_sel->type != type_v_src &&
+                (type_v_src == GGML_TYPE_F16 || type_v_src == GGML_TYPE_BF16)) {
+                v_sel = ggml_cast(ctx0, v_sel, type_v_src);
+            }
+
+            // k/v are in the standard cache layout in both the gathered
+            // and dense cases; append the pooled rows on the kv axis.
+            k = ggml_concat(ctx0, k, k_sel, 2);
+            v = ggml_concat(ctx0, v, v_sel, 2);
+
+            // Pooled-row causal mask: gather the pre-gather mask rows of
+            // each block's last token (its position is the block max_pos,
+            // so the row encodes exactly q_pos > block_max_pos).
+            ggml_tensor * m_p = ggml_cont(ctx0,
+                    ggml_permute(ctx0, mask_full, 1, 0, 2, 3));
+            ggml_tensor * m_pool = ggml_get_rows(ctx0, m_p, inp->pool_idx_m);
+            m_pool = ggml_cont(ctx0, ggml_permute(ctx0, m_pool, 1, 0, 2, 3));
+            if (m_pool->type != mask_full->type) {
+                m_pool = ggml_cast(ctx0, m_pool, mask_full->type);
+            }
+            ggml_tensor * mask_cur = scalar_gathered ? kq_mask : mask_full;
+            kq_mask = ggml_concat(ctx0, mask_cur, m_pool, 0);
+        }
+    }
+
+    cur = build_attn_mha(q, k, v, kq_b, kq_mask, sinks, v_mla, 0, kq_scale, il);
+    }
     cb(cur, "kqv_out", il);
 
     if (inp->self_v_rot) {
