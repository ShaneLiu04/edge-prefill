+    LLAMA_API int32_t llama_set_prefill_qg_bound(
+            struct llama_context * ctx,
+                     int32_t      enabled,
+                     int32_t      sel_pages,
+                     int32_t      local_pages,
+                     int32_t      pool_pages);
+
+    // Returns 1 when bound gating is armed, 0 otherwise.
+    LLAMA_API int32_t llama_get_prefill_qg_bound(const struct llama_context * ctx);
+
+    // Sets the layer x head top-k matrix (n must equal n_layer * n_head).
+    // An element of -1 marks a dense head (no gathering); >= 1 gathers the
