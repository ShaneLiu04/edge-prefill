+    // fidelity. The pooled row is causally gated by the block's max
+    // position, which equals the pre-gather mask row of the block's last
+    // token. v1: exclusive with the per-head matrix path.
+    if (cparams.prefill_mode &&
+        !cparams.prefill_attn_pool_starts.empty() &&
+        cparams.prefill_attn_head_top_k.empty() &&
+        !cparams.flash_attn && kq_b == nullptr && sinks == nullptr &&
+        v_mla == nullptr) {
