+    // A fresh count resets the row/bound state so a half-configured plan
+    // can never reach the graph.
+    void set_prefill_qg_count(int32_t n_groups) {
+        cparams.prefill_qg_count = n_groups;
+        cparams.prefill_qg_set_groups = 0;
+        cparams.prefill_qg_rows.clear();
+        cparams.prefill_qg_offsets.assign(
+            n_groups > 0 ? static_cast<size_t>(n_groups) + 1 : 0, 0);
+        cparams.prefill_qg_bounds.clear();
+        ++cparams.prefill_edge_epoch;
