 }
 
+// EdgePrefill extension: attention-level top-k sparse prefill.
+int32_t llama_set_prefill_attn_top_k(llama_context * ctx, int32_t top_k) {
+    if (!ctx || top_k < 0) {
+        return 2; // InvalidArgument
+    }
+    ctx->set_prefill_attn_top_k(top_k);
+    return 0;
+}
+
+int32_t llama_get_prefill_attn_top_k(const llama_context * ctx) {
+    return ctx ? ctx->get_prefill_attn_top_k() : 0;
+}
+
+int32_t llama_set_prefill_attn_indices(llama_context * ctx, const int32_t * indices, size_t n) {
+    if (!ctx) {
+        return 2; // InvalidArgument
+    }
+    if (n == 0) {
+        // Clearing restores the original dense path.
+        ctx->set_prefill_attn_indices({});
+        return 0;
+    }
+    if (!indices) {
+        return 2; // InvalidArgument
+    }
+    // Indices must be strictly ascending and within the context capacity.
+    // Gathered indices address token positions, which can never exceed n_ctx;
+    // the graph builder additionally skips gathering when n_idx >= live n_kv.
+    const uint32_t bound = ctx->n_ctx();
+    for (size_t i = 0; i < n; ++i) {
+        if (indices[i] < 0 || static_cast<uint32_t>(indices[i]) >= bound) {
+            return 2; // InvalidArgument
+        }
+        if (i > 0 && indices[i] <= indices[i - 1]) {
+            return 2; // InvalidArgument: not strictly ascending
+        }
+    }
+    ctx->set_prefill_attn_indices(std::vector<int32_t>(indices, indices + n));
+    return 0;
+}
+
+int32_t llama_get_prefill_attn_indices_size(const llama_context * ctx) {
+    if (!ctx) {
+        return 0;
+    }
+    const auto & indices = ctx->get_prefill_attn_indices();
+    return indices.size() > INT32_MAX ? INT32_MAX : static_cast<int32_t>(indices.size());
+}
+
+// EdgePrefill extension: per-head adaptive sparse prefill.
+int32_t llama_set_prefill_attn_ranked_rows(llama_context * ctx, const int32_t * rows, size_t n) {
+    if (!ctx) {
+        return 2; // InvalidArgument
+    }
+    if (n == 0) {
+        // Clearing the pool leaves an already-set matrix inert (the graph
+        // requires a non-empty pool) and restores the scalar path.
+        ctx->set_prefill_attn_ranked_rows({});
+        return 0;
+    }
+    if (!rows) {
+        return 2; // InvalidArgument
+    }
+    // Rows address KV cache cells, which can never exceed the context
+    // capacity. Rank order is preserved; duplicates are legal and deduped
+    // per group when the graph builds its gathered row sets.
+    const uint32_t bound = ctx->n_ctx();
+    for (size_t i = 0; i < n; ++i) {
+        if (rows[i] < 0 || static_cast<uint32_t>(rows[i]) >= bound) {
+            return 2; // InvalidArgument
+        }
+    }
+    ctx->set_prefill_attn_ranked_rows(std::vector<int32_t>(rows, rows + n));
+    return 0;
+}
+
+int32_t llama_get_prefill_attn_ranked_rows_size(const llama_context * ctx) {
+    if (!ctx) {
+        return 0;
+    }
+    const auto & rows = ctx->get_prefill_attn_ranked_rows();
+    return rows.size() > INT32_MAX ? INT32_MAX : static_cast<int32_t>(rows.size());
+}
+
+int32_t llama_set_prefill_attn_head_top_k(llama_context * ctx, const int32_t * top_k, size_t n) {
+    if (!ctx) {
+        return 2; // InvalidArgument
+    }
+    if (n == 0) {
+        // Clearing restores the AR002 scalar top-k path.
+        ctx->set_prefill_attn_head_top_k({});
+        return 0;
+    }
+    if (!top_k) {
+        return 2; // InvalidArgument
+    }
+    // A non-empty matrix without a ranked pool could never execute; reject
+    // the half-configured state instead of silently ignoring the matrix.
+    if (ctx->get_prefill_attn_ranked_rows().empty()) {
+        return 2; // InvalidArgument
+    }
+    const auto & hparams = ctx->get_model().hparams;
+    const int64_t expected = static_cast<int64_t>(hparams.n_layer()) * static_cast<int64_t>(hparams.n_head(0));
+    if (static_cast<int64_t>(n) != expected) {
+        return 2; // InvalidArgument
+    }
+    for (size_t i = 0; i < n; ++i) {
+        if (top_k[i] == 0 || top_k[i] < -1) {
+            return 2; // InvalidArgument
+        }
+    }
+    ctx->set_prefill_attn_head_top_k(std::vector<int32_t>(top_k, top_k + n));
+    return 0;
+}
+
+int32_t llama_get_prefill_attn_head_top_k_size(const llama_context * ctx) {
+    if (!ctx) {
+        return 0;
+    }
+    const auto & matrix = ctx->get_prefill_attn_head_top_k();
+    return matrix.size() > INT32_MAX ? INT32_MAX : static_cast<int32_t>(matrix.size());
+}
+
+// EdgePrefill AR004: attention-level compressed branches (pooled block rows).
+int32_t llama_set_prefill_attn_pool_blocks(llama_context * ctx,
+                                           const int32_t * block_row_starts,
+                                           const int32_t * block_row_sizes,
+                                           const int32_t * block_max_pos,
+                                           size_t n) {
+    if (!ctx) {
+        return 2; // InvalidArgument
+    }
+    if (n == 0) {
+        ctx->set_prefill_attn_pool_blocks({}, {}, {});
+        return 0;
+    }
+    if (!block_row_starts || !block_row_sizes || !block_max_pos) {
+        return 2; // InvalidArgument
+    }
+    if (n > 1024) {
+        return 2; // InvalidArgument: block-set budget from the design contract
+    }
+    // Blocks address compacted KV rows; starts must tile the row space in
+    // 32-row units because the graph pools with ggml_pool_1d(AVG, 32, 32)
+    // and indexes pooled rows by start/32. Rows can never exceed context
+    // capacity. max_pos drives the pooled row's causal gate and must be a
+    // valid position.
+    const uint32_t bound = ctx->n_ctx();
+    for (size_t i = 0; i < n; ++i) {
+        if (block_row_starts[i] < 0 ||
+            static_cast<uint32_t>(block_row_starts[i]) % 32 != 0) {
+            return 2; // InvalidArgument: misaligned start
+        }
+        if (block_row_sizes[i] != 32) {
+            return 2; // InvalidArgument: pool_1d geometry requires 32
+        }
+        if (static_cast<uint32_t>(block_row_starts[i]) +
+                static_cast<uint32_t>(block_row_sizes[i]) > bound) {
+            return 2; // InvalidArgument: rows beyond context capacity
+        }
+        if (block_max_pos[i] < 0) {
+            return 2; // InvalidArgument
+        }
+    }
+    ctx->set_prefill_attn_pool_blocks(
+            std::vector<int32_t>(block_row_starts, block_row_starts + n),
+            std::vector<int32_t>(block_row_sizes, block_row_sizes + n),
+            std::vector<int32_t>(block_max_pos, block_max_pos + n));
+    return 0;
+}
+
+int32_t llama_get_prefill_attn_pool_blocks_size(const llama_context * ctx) {
+    if (!ctx) {
+        return 0;
+    }
+    const auto & starts = ctx->get_prefill_attn_pool_starts();
+    return starts.size() > INT32_MAX ? INT32_MAX : static_cast<int32_t>(starts.size());
+}
+
+int32_t llama_set_prefill_qg_count(llama_context * ctx, int32_t n_groups) {
+    if (!ctx) {
+        return 2; // InvalidArgument
+    }
+    if (n_groups < 0 || n_groups > 16) {
+        return 2; // InvalidArgument: group budget from the design contract
+    }
+    ctx->set_prefill_qg_count(n_groups);
+    return 0;
+}
+
+int32_t llama_set_prefill_qg_rows(llama_context * ctx, int32_t group,
+                                  const int32_t * rows, size_t n) {
+    if (!ctx || (n > 0 && !rows)) {
+        return 2; // InvalidArgument
+    }
+    const int32_t count = ctx->get_prefill_qg_count();
+    if (count <= 0 || group < 0 || group >= count) {
+        return 2; // InvalidArgument: group out of range
+    }
+    // Append-only state machine: groups must be configured in order so a
+    // half-written plan never reaches the graph.
+    if (group != ctx->get_prefill_qg_set_groups()) {
+        return 2; // InvalidArgument: groups must be set in ascending order
+    }
+    if (n > 4096) {
+        return 2; // InvalidArgument: per-group graph width guard
+    }
+    const uint32_t bound = ctx->n_ctx();
+    for (size_t i = 0; i < n; ++i) {
+        if (rows[i] < 0 || static_cast<uint32_t>(rows[i]) >= bound) {
+            return 2; // InvalidArgument: row beyond context capacity
+        }
+        if (i > 0 && rows[i] <= rows[i - 1]) {
+            return 2; // InvalidArgument: rows must be strictly ascending
+        }
+    }
+    ctx->append_prefill_qg_group_rows(
+            group, std::vector<int32_t>(rows, rows + n));
+    return 0;
+}
+
+int32_t llama_set_prefill_qg_bounds(llama_context * ctx, const int32_t * q_bounds, size_t n) {
+    if (!ctx || !q_bounds) {
+        return 2; // InvalidArgument
+    }
+    const int32_t count = ctx->get_prefill_qg_count();
+    if (count <= 0 || n != static_cast<size_t>(count) + 1) {
+        return 2; // InvalidArgument: bounds length must be count + 1
+    }
+    if (ctx->get_prefill_qg_set_groups() != count) {
+        return 2; // InvalidArgument: all group rows must be set first
+    }
+    if (q_bounds[0] != 0) {
+        return 2; // InvalidArgument: bounds must start at 0
+    }
+    for (size_t i = 1; i < n; ++i) {
+        if (q_bounds[i] <= q_bounds[i - 1]) {
+            return 2; // InvalidArgument: bounds must be strictly ascending
+        }
+    }
+    ctx->set_prefill_qg_bounds(std::vector<int32_t>(q_bounds, q_bounds + n));
+    return 0;
+}
+
+int32_t llama_get_prefill_qg_count(const llama_context * ctx) {
+    if (!ctx) {
+        return 0;
+    }
+    return ctx->get_prefill_qg_count();
+}
+
+int32_t llama_set_prefill_qg_bound(llama_context * ctx, int32_t enabled,
+                                   int32_t sel_pages, int32_t local_pages,
+                                   int32_t pool_pages) {
+    if (!ctx) {
+        return 2; // InvalidArgument
+    }
+    if (enabled != 0 && enabled != 1) {
+        return 2; // InvalidArgument
+    }
+    if (sel_pages < 0 || sel_pages > 128 ||
+        local_pages < 0 || local_pages > 1024 || pool_pages < 0) {
+        return 2; // InvalidArgument: graph width / budget guards
+    }
+    if (enabled) {
+        // Bound gating replaces every other sparse attention mechanism.
+        // Clear the conflicting state so the graph has exactly one owner.
+        ctx->set_prefill_qg_count(0);
+        ctx->set_prefill_attn_top_k(0);
+        ctx->set_prefill_attn_indices({});
+        ctx->set_prefill_attn_head_top_k({});
+        ctx->set_prefill_attn_ranked_rows({});
+        ctx->set_prefill_attn_pool_blocks({}, {}, {});
+    }
+    ctx->set_prefill_qg_bound(enabled, enabled ? sel_pages : 0,
+                              enabled ? local_pages : 0,
+                              enabled ? pool_pages : 0);
+    return 0;
+}
+
+int32_t llama_get_prefill_qg_bound(const llama_context * ctx) {
+    if (!ctx) {
+        return 0;
+    }
+    return ctx->get_prefill_qg_bound();
+}
+
 //
 // memory
 //
