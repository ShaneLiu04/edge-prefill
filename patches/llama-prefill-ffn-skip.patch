     return res ? 0 : -1;
 }
 
+// EdgePrefill extension
+void llama_set_prefill_mode(llama_context * ctx, bool prefill) {
+    if (!ctx) {
+        return;
+    }
+    ctx->set_prefill_mode(prefill);
+}
+
+void llama_set_prefill_ffn_skip(llama_context * ctx, uint64_t layer_mask) {
+    if (!ctx) {
+        return;
+    }
+    const int32_t n_layer = llama_model_n_layer(llama_get_model(ctx));
+    if (n_layer > 0 && n_layer < 64) {
+        layer_mask &= ((uint64_t(1) << n_layer) - 1);
+    } else if (n_layer >= 64) {
+        layer_mask = 0;
+    }
+    ctx->set_prefill_ffn_skip(layer_mask);
+}
+
+uint64_t llama_get_prefill_ffn_skip(const llama_context * ctx) {
+    return ctx ? ctx->get_prefill_ffn_skip() : 0;
+}
+
+bool llama_get_prefill_mode(const llama_context * ctx) {
+    return ctx ? ctx->get_prefill_mode() : false;
+}
+
